NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Local/admin script only. Do not add these to Vercel.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
TPS_DEFAULT_PASSWORD=change-this-before-running
# Optional per-account override, JSON object. Example:
# TPS_PASSWORDS_JSON={"TPS01":"unique-password-01","TPS02":"unique-password-02"}
ADMIN_PASSWORD=change-this-admin-password
